{
  "opencollection": "1.0.0",
  "info": {
    "name": "TikTok API for Business Ad Groups Finance API",
    "version": "v1.3"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Access-Token",
      "value": "{{Access-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Finance",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Payments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://business-api.tiktok.com/finance/202309/payments",
            "params": [
              {
                "name": "page_size",
                "value": "",
                "type": "query"
              },
              {
                "name": "page_token",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Retrieves payment settlement records for the seller's TikTok Shop."
        }
      ]
    }
  ],
  "bundled": true
}