{
  "opencollection": "1.0.0",
  "info": {
    "name": "TikTok API for Business Ad Groups API",
    "version": "v1.3"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Access-Token",
      "value": "{{Access-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Ad Groups",
        "type": "folder"
      },
      "items": [
        {
          "info": {
